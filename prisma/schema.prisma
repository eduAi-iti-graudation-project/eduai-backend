datasource db {
  provider   = "postgresql"
  extensions = [vector]
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

enum UserRole {
  TEACHER
  STUDENT
  GUARDIAN
  ADMIN
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum TeacherDocumentType {
  SOCIAL_SECURITY
  NATIONAL_ID
  PASSPORT
  LICENSE
  DEGREE
  CONTRACT
  OTHER
}

enum SalaryStatus {
  PAID
  PARTIAL
  POSTPONED
  UNPAID
}

enum SubscriptionTier {
  TRIAL
  BASIC
  PRO
  ENTERPRISE
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
}

enum NotificationChannel {
  EMAIL
  PUSH
}

enum AlertStatus {
  ACTIVE
  RESOLVED
  DISMISSED
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum ReportStatus {
  NEW
  SENT
  VIEWED
}

enum SubmissionStatus {
  SUBMITTED
  GRADING_IN_PROGRESS
  REVIEW_READY
  CONFIRMED
}

enum EnrollmentStatus {
  PENDING
  APPROVED
  REJECTED
}

enum JoinRequestSource {
  ROSTER
  SELF
}

enum JoinRequestKind {
  STUDENT
  GUARDIAN
}

enum JoinRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum QuizStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

enum LabStatus {
  GENERATING
  AI_REVIEW_FAILED
  PENDING_TEACHER_REVIEW
  PUBLISHED
  REJECTED
}

enum QuestionType {
  MCQ
  TRUE_FALSE
  SHORT_ANSWER
  ESSAY
}

enum AttemptStatus {
  IN_PROGRESS
  COMPLETED
}

enum FeeType {
  TUITION
  REGISTRATION
  EXAM
  MATERIALS
  OTHER
}

enum FeeStatus {
  PAID
  PARTIAL
  POSTPONED
  UNPAID
}

model Organization {
  id                   String             @id @default(uuid()) @db.Uuid
  name                 String
  joinCode             String             @unique
  // Login identity domain for school-provisioned accounts (students/guardians).
  // Derived at creation as slugify(name) + ".org"; editable by admins.
  emailDomain          String?
  groupId              String?            @db.Uuid
  group                SchoolGroup?       @relation(fields: [groupId], references: [id], onDelete: SetNull)
  stripeCustomerId     String?            @unique
  stripeSubscriptionId String?            @unique
  subscriptionTier     SubscriptionTier   @default(TRIAL)
  subscriptionStatus   SubscriptionStatus @default(TRIALING)
  seatLimit            Int?
  createdAt            DateTime           @default(now())
  trialReminderSentAt  DateTime?
  trialExpiredSentAt   DateTime?

  users              User[]
  gradeLevels        GradeLevel[]
  sections           Section[]
  courses            Course[]
  courseOfferings    CourseOffering[]
  subscriptionEvents SubscriptionEvent[]
  membershipRequests MembershipRequest[]
  studentDocuments   StudentDocument[]
  joinRequests       JoinRequest[]

  @@index([groupId])
  @@map("organizations")
}

model SchoolGroup {
  id                   String             @id @default(uuid()) @db.Uuid
  name                 String
  stripeCustomerId     String?            @unique
  stripeSubscriptionId String?            @unique
  subscriptionTier     SubscriptionTier   @default(TRIAL)
  subscriptionStatus   SubscriptionStatus @default(TRIALING)
  seatLimit            Int?
  createdAt            DateTime           @default(now())

  organizations Organization[]

  @@map("school_groups")
}

model MembershipRequest {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @db.Uuid
  email          String
  name           String
  role           UserRole
  status         EnrollmentStatus @default(PENDING)
  gradeLevel     Int?
  authId         String?
  photoUrl       String?
  ssnEncrypted   String?
  ssnTail4       String?
  phone          String?
  street         String?
  city           String?
  nationality    String?
  personalEmail  String?
  dateOfBirth    DateTime?
  emergencyContactName         String?
  emergencyContactPhone        String?
  emergencyContactRelationship  String?
  createdAt      DateTime         @default(now())
  resolvedAt     DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("membership_requests")
}

model TeacherProfile {
  id                          String    @id @default(uuid()) @db.Uuid
  teacherId                   String    @unique @db.Uuid
  ssnEncrypted                String?
  ssnTail4                    String?
  phone                       String?
  street                      String?
  city                        String?
  nationality                 String?
  personalEmail               String?
  dateOfBirth                 DateTime?
  emergencyContactName        String?
  emergencyContactPhone       String?
  emergencyContactRelationship String?
  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @updatedAt

  teacher User @relation("TeacherProfile", fields: [teacherId], references: [id], onDelete: Cascade)

  @@map("teacher_profiles")
}

model GuardianProfile {
  id                          String    @id @default(uuid()) @db.Uuid
  guardianId                  String    @unique @db.Uuid
  ssnEncrypted                String?
  ssnTail4                    String?
  phone                       String?
  street                      String?
  city                        String?
  nationality                 String?
  personalEmail               String?
  dateOfBirth                 DateTime?
  emergencyContactName        String?
  emergencyContactPhone       String?
  emergencyContactRelationship String?
  profileComplete             Boolean   @default(false)
  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @updatedAt

  guardian User @relation("GuardianProfile", fields: [guardianId], references: [id], onDelete: Cascade)

  @@map("guardian_profiles")
}

model JoinRequest {
  id             String            @id @default(uuid()) @db.Uuid
  organizationId String            @db.Uuid
  source         JoinRequestSource
  kind           JoinRequestKind   @default(STUDENT)
  status         JoinRequestStatus @default(PENDING)
  email          String
  name           String
  authId         String?           @unique
  gradeId        String?           @db.Uuid
  gradeLevelName String?
  sectionId      String?           @db.Uuid
  sectionName    String?
  decidedById    String?           @db.Uuid
  decidedAt      DateTime?
  note           String?
  appliedAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  // The applicant's chosen password, encrypted — kept as the school login
  // password when the account is provisioned with a school email on approval.
  chosenPasswordEncrypted String?
  // GUARDIAN-kind requests: the child's school email to link on approval.
  targetStudentEmail       String?

  guardianName                String?
  guardianEmail               String?
  guardianSsnEncrypted        String?
  guardianSsnTail4            String?
  guardianPhone               String?
  guardianNationality         String?
  guardianStreet              String?
  guardianCity                String?
  guardianDateOfBirth         DateTime?

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  grade        GradeLevel?   @relation(fields: [gradeId], references: [id])
  section      Section?      @relation(fields: [sectionId], references: [id])
  decidedBy    User?         @relation("JoinRequestDecidedBy", fields: [decidedById], references: [id])
  // Set on approval: links the row to the provisioned user, so credential
  // recovery ("resend") can resolve the real inbox back to the account.
  user         User?         @relation("JoinRequestUser", fields: [userId], references: [id], onDelete: SetNull)
  userId       String?       @db.Uuid

  @@index([organizationId, status])
  @@index([organizationId, email])
  @@index([userId])
  @@map("join_requests")
}

model SubscriptionEvent {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  stripeEventId  String   @unique
  type           String
  raw            Json
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("subscription_events")
}

model GradeLevel {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  level          Int
  name           String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  students     User[]
  sections     Section[]
  courses      Course[]
  joinRequests JoinRequest[]

  @@unique([organizationId, level])
  @@index([organizationId])
  @@map("grade_levels")
}

model Section {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  gradeLevelId   String   @db.Uuid
  name           String
  description    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id])
  gradeLevel   GradeLevel       @relation(fields: [gradeLevelId], references: [id], onDelete: Cascade)
  enrollments  Enrollment[]
  attendance   Attendance[]
  offerings    CourseOffering[]
  joinRequests JoinRequest[]

  @@unique([organizationId, gradeLevelId, name])
  @@index([organizationId])
  @@map("sections")
}

model Course {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  gradeLevelId   String   @db.Uuid
  name           String
  description    String?
  colorTag       String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id])
  gradeLevel   GradeLevel       @relation(fields: [gradeLevelId], references: [id], onDelete: Cascade)
  offerings    CourseOffering[]
  materials    Material[]
  chapters     MaterialChapter[]

  @@unique([organizationId, gradeLevelId, name])
  @@index([organizationId])
  @@map("courses")
}

model CourseOffering {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  courseId       String   @db.Uuid
  sectionId      String   @db.Uuid
  teacherId      String   @db.Uuid
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization     Organization              @relation(fields: [organizationId], references: [id])
  course           Course                    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  section          Section                   @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  teacher          User                      @relation("CourseOfferingTeacher", fields: [teacherId], references: [id])
  assignments      Assignment[]
  materials        Material[]
  chapters         MaterialChapter[]
  quizzes          Quiz[]
  alerts           Alert[]
  chatThreads      ChatThread[]
  teacherLogs      ClassTeacherLog[]
  analyses         StudentAnalysis[]
  homeworkHelp     HomeworkHelpInteraction[]
  timetableSlots   TimetableSlot[]
  studyGenerations StudyGeneration[]
  meetings         Meeting[]
  labs             Lab[]

  @@unique([courseId, sectionId])
  @@index([organizationId])
  @@index([teacherId])
  @@map("course_offerings")
}

model Meeting {
  id                            String           @id @default(uuid()) @db.Uuid
  organizationId                String           @db.Uuid
  title                         String
  type                          MeetingType
  courseOfferingId              String?          @db.Uuid
  createdBy                     String           @db.Uuid
  scheduledStart                DateTime
  scheduledEnd                  DateTime
  status                        MeetingStatus    @default(SCHEDULED)
  roomName                      String           @unique
  recordingEnabled              Boolean          @default(false)
  recordingUrl                  String?
  recordingEgressId             String?
  transcriptStatus              TranscriptStatus @default(PENDING)
  // Per-participant track transcriptions still in flight; struggle-signal
  // extraction runs once this reaches 0 after a recorded meeting.
  pendingParticipantTranscripts Int              @default(0)
  // True once struggle-signal extraction has run for this meeting (one-shot).
  struggleSignalsProcessed      Boolean          @default(false)
  createdAt                     DateTime         @default(now())

  courseOffering     CourseOffering?            @relation(fields: [courseOfferingId], references: [id], onDelete: Cascade)
  createdByUser      User                       @relation("MeetingHost", fields: [createdBy], references: [id])
  participants       MeetingParticipant[]
  attendance         MeetingAttendance[]
  chatMessages       MeetingChatMessage[]
  transcripts        MeetingTranscript[]
  transcriptSegments MeetingTranscriptSegment[]
  struggleSignals    StruggleSignal[]

  @@index([organizationId])
  @@index([courseOfferingId])
  @@index([createdBy])
  @@index([scheduledStart])
  @@map("meetings")
}

model MeetingParticipant {
  id        String @id @default(uuid()) @db.Uuid
  meetingId String @db.Uuid
  userId    String @db.Uuid

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([meetingId, userId])
  @@index([userId])
  @@map("meeting_participants")
}

model MeetingAttendance {
  id        String    @id @default(uuid()) @db.Uuid
  meetingId String    @db.Uuid
  userId    String    @db.Uuid
  joinedAt  DateTime  @default(now())
  leftAt    DateTime?

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([meetingId])
  @@index([userId])
  @@map("meeting_attendance")
}

model MeetingChatMessage {
  id        String   @id @default(uuid()) @db.Uuid
  meetingId String   @db.Uuid
  userId    String   @db.Uuid
  text      String
  createdAt DateTime @default(now())

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([meetingId, createdAt])
  @@map("meeting_chat_messages")
}

model MeetingTranscript {
  id        String @id @default(uuid()) @db.Uuid
  meetingId String @db.Uuid
  order     Int
  startMs   Int
  endMs     Int
  text      String

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@index([meetingId])
  @@map("meeting_transcripts")
}

/**
 * Per-participant transcript segment: produced from each participant's own
 * audio track (per-track egress), so speaker attribution is deterministic —
 * the userId comes from that participant's join token, never from AI
 * speaker diarization.
 */
model MeetingTranscriptSegment {
  id        String   @id @default(uuid()) @db.Uuid
  meetingId String   @db.Uuid
  userId    String   @db.Uuid
  text      String   @db.Text
  // Seconds from meeting start (Whisper timestamps on the participant's track).
  timestamp Int
  // The role of the user at the time of the meeting.
  role      UserRole

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([meetingId])
  @@index([userId, meetingId])
  @@map("meeting_transcript_segments")
}

/**
 * A teacher-reviewable, per-student note about a concept a student seemed
 * confused about during a recorded meeting. Extracted from the redacted
 * per-participant transcript; only dispatched to the student when a teacher
 * explicitly sends it (status PENDING -> SENT), or dismissed (DISMISSED).
 */
model StruggleSignal {
  id            String   @id @default(uuid()) @db.Uuid
  meetingId     String   @db.Uuid
  studentId     String   @db.Uuid
  concept       String
  explanation   String   @db.Text
  status        String   @default("PENDING") // PENDING / SENT / DISMISSED
  // True when >= 3 students shared fuzzy-matched concepts (class-wide note).
  classWide     Boolean  @default(false)
  quizId        String?  @db.Uuid
  interactionId String?  @db.Uuid
  createdAt     DateTime @default(now())

  meeting Meeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  student User    @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([meetingId, status])
  @@index([studentId])
  @@map("struggle_signals")
}

model TimetableSlot {
  id               String    @id @default(uuid()) @db.Uuid
  courseOfferingId String    @db.Uuid
  organizationId   String    @db.Uuid
  dayOfWeek        DayOfWeek
  startTime        DateTime  @db.Time
  endTime          DateTime  @db.Time
  room             String?
  createdAt        DateTime  @default(now())

  courseOffering CourseOffering @relation(fields: [courseOfferingId], references: [id], onDelete: Cascade)

  @@index([courseOfferingId])
  @@index([organizationId, dayOfWeek])
  @@index([courseOfferingId, dayOfWeek])
  @@map("timetable_slots")
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum MeetingType {
  CLASS
  AD_HOC
}

enum MeetingStatus {
  SCHEDULED
  LIVE
  ENDED
  CANCELED
}

enum TranscriptStatus {
  PENDING
  PROCESSING
  READY
  FAILED
}

model User {
  id             String   @id @default(uuid()) @db.Uuid
  authId         String?  @unique
  email          String   @unique
  name           String
  role           UserRole
  gradeId        String?  @db.Uuid
  guardianId     String?  @db.Uuid
  organizationId String   @db.Uuid
  gender         Gender?
  avatarUrl      String?
  // AES-256-GCM of the generated school credential (key CREDENTIALS_ENCRYPTION_KEY).
  // School mailboxes are not real, so this is the recovery path for "resend".
  credentialEncrypted String?
  // One-time reveal flow: verify-by-token then reveal credentials once.
  verifyToken          String?   @unique
  verifyTokenExpiresAt DateTime?
  emailVerifiedAt      DateTime?
  // Self-service password reset for school accounts: a self-issued token
  // delivered to the verified real inbox (school mailboxes don't exist, so
  // Supabase reset links can never arrive).
  resetToken          String?   @unique
  resetTokenExpiresAt DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

grade                     GradeLevel?                @relation(fields: [gradeId], references: [id])
  organization              Organization               @relation(fields: [organizationId], references: [id])
  teacherProfile            TeacherProfile?            @relation("TeacherProfile")
  guardianProfile           GuardianProfile?           @relation("GuardianProfile")
  teacherOfferings          CourseOffering[]           @relation("CourseOfferingTeacher")
  teacherQuizzes            Quiz[]                     @relation("TeacherQuizzes")
  assignedQuizzes           Quiz[]                     @relation("StudentAssignedQuizzes")
  enrollments               Enrollment[]
  submissions               Submission[]
  quizAttempts              QuizAttempt[]
  alerts                    Alert[]
  analyses                  StudentAnalysis[]
  notifications             Notification[]
  reports                   StudentReport[]
  deviceTokens              DeviceToken[]
  attendance                Attendance[]
  homeworkHelpInteractions  HomeworkHelpInteraction[]
  studyGenerations          StudyGeneration[]
  guardian                  User?                      @relation("GuardianWards", fields: [guardianId], references: [id])
  wards                     User[]                     @relation("GuardianWards")
  threadsAsTeacher          ChatThread[]               @relation("ThreadTeacher")
  threadsAsStudent          ChatThread[]               @relation("ThreadStudent")
  chatMessages              ChatMessage[]
  documents                 StudentDocument[]          @relation("StudentDocuments")
  uploadedDocuments         StudentDocument[]          @relation("DocumentsUploadedBy")
  aiSuggestedDocuments      StudentDocument[]          @relation("DocumentsAiSuggestedStudent")
  feePayments               FeePayment[]
  classTeacherLogs          ClassTeacherLog[]          @relation("TeacherClassLogs")
  teacherDocuments          TeacherDocument[]          @relation("TeacherDocuments")
  uploadedTeacherDocuments  TeacherDocument[]          @relation("TeacherDocumentsUploadedBy")
  salaryRecords             SalaryRecord[]
  meetingsHosted            Meeting[]                  @relation("MeetingHost")
  meetingParticipants       MeetingParticipant[]
  meetingAttendance         MeetingAttendance[]
  meetingChatMessages       MeetingChatMessage[]
  meetingTranscriptSegments MeetingTranscriptSegment[]
  struggleSignals           StruggleSignal[]
  joinRequestsDecided       JoinRequest[]              @relation("JoinRequestDecidedBy")
  joinRequestsCreated       JoinRequest[]              @relation("JoinRequestUser")

  @@index([organizationId])
  @@map("users")
}

model Enrollment {
  id        String           @id @default(uuid()) @db.Uuid
  sectionId String           @db.Uuid
  studentId String           @db.Uuid
  status    EnrollmentStatus @default(PENDING)
  createdAt DateTime         @default(now())

  // Relations
  section Section @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  student User    @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([sectionId, studentId])
  @@map("enrollments")
}

model Attendance {
  id        String           @id @default(uuid()) @db.Uuid
  studentId String           @db.Uuid
  sectionId String           @db.Uuid
  date      DateTime         @db.Date
  status    AttendanceStatus
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  // Relations
  student User    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  section Section @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@unique([studentId, sectionId, date])
  @@map("attendance")
}

model Material {
  id               String   @id @default(uuid()) @db.Uuid
  title            String
  fileUrl          String?
  courseOfferingId String   @db.Uuid
  courseId         String?  @db.Uuid
  assignmentId     String?  @db.Uuid
  chapterId        String?  @db.Uuid
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // Relations
  offering   CourseOffering      @relation(fields: [courseOfferingId], references: [id], onDelete: Cascade)
  course     Course?             @relation(fields: [courseId], references: [id], onDelete: SetNull)
  assignment Assignment?         @relation(fields: [assignmentId], references: [id], onDelete: SetNull)
  chapter    MaterialChapter?    @relation(fields: [chapterId], references: [id], onDelete: SetNull)
  chunks     MaterialChunk[]

  @@index([assignmentId])
  @@index([chapterId])
  @@index([courseId])
  @@map("materials")
}

model MaterialChunk {
  id         String                       @id @default(uuid()) @db.Uuid
  materialId String                       @db.Uuid
  content    String
  embedding  Unsupported("vector(1024)")?
  createdAt  DateTime                     @default(now())

  // Relations
  material Material @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@map("material_chunks")
}

model MaterialChapter {
  id               String   @id @default(uuid()) @db.Uuid
  courseOfferingId String?  @db.Uuid
  courseId         String?  @db.Uuid
  title            String
  order            Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // Relations
  offering  CourseOffering? @relation(fields: [courseOfferingId], references: [id], onDelete: Cascade)
  course    Course?         @relation(fields: [courseId], references: [id], onDelete: SetNull)
  materials Material[]

  @@index([courseOfferingId, order])
  @@index([courseId, order])
  @@map("material_chapters")
}

model Assignment {
  id               String   @id @default(uuid()) @db.Uuid
  title            String
  description      String?
  dueDate          DateTime
  totalPoints      Int
  courseOfferingId String   @db.Uuid
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // Relations
  offering    CourseOffering @relation(fields: [courseOfferingId], references: [id], onDelete: Cascade)
  rubrics     Rubric[]
  submissions Submission[]
  materials   Material[]

  @@map("assignments")
}

model Rubric {
  id           String   @id @default(uuid()) @db.Uuid
  title        String
  assignmentId String   @db.Uuid
  isConfirmed  Boolean  @default(false)
  createdAt    DateTime @default(now())

  // Relations
  assignment Assignment       @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  criteria   RubricCriteria[]

  @@map("rubrics")
}

model RubricCriteria {
  id          String                       @id @default(uuid()) @db.Uuid
  rubricId    String                       @db.Uuid
  description String
  maxPoints   Int
  embedding   Unsupported("vector(1024)")?
  createdAt   DateTime                     @default(now())

  // Relations
  rubric        Rubric         @relation(fields: [rubricId], references: [id], onDelete: Cascade)
  gradingScores GradingScore[]

  @@map("rubric_criteria")
}

model Submission {
  id                String           @id @default(uuid()) @db.Uuid
  assignmentId      String           @db.Uuid
  studentId         String           @db.Uuid
  status            SubmissionStatus @default(SUBMITTED)
  teacherNotes      String?
  finalScore        Int?
  aiOverallFeedback String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  // Relations
  assignment Assignment        @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student    User              @relation(fields: [studentId], references: [id], onDelete: Cascade)
  chunks     SubmissionChunk[]
  scores     GradingScore[]

  @@unique([assignmentId, studentId])
  @@map("submissions")
}

model SubmissionChunk {
  id           String                       @id @default(uuid()) @db.Uuid
  submissionId String                       @db.Uuid
  content      String
  embedding    Unsupported("vector(1024)")?
  createdAt    DateTime                     @default(now())

  // Relations
  submission Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@map("submission_chunks")
}

model GradingScore {
  id            String   @id @default(uuid()) @db.Uuid
  submissionId  String   @db.Uuid
  criteriaId    String   @db.Uuid
  pointsAwarded Int
  aiFeedback    String?
  teacherNotes  String?
  isConfirmed   Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  submission Submission     @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  criteria   RubricCriteria @relation(fields: [criteriaId], references: [id], onDelete: Cascade)

  @@unique([submissionId, criteriaId])
  @@map("grading_scores")
}

model Alert {
  id               String      @id @default(uuid()) @db.Uuid
  type             String
  reason           String
  status           AlertStatus @default(ACTIVE)
  studentId        String      @db.Uuid
  courseOfferingId String?     @db.Uuid
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  student  User              @relation(fields: [studentId], references: [id], onDelete: Cascade)
  offering CourseOffering?   @relation(fields: [courseOfferingId], references: [id])
  reports  StudentReport[]
  analyses StudentAnalysis[]

  @@map("alerts")
}

model StudentAnalysis {
  id                String   @id @default(uuid()) @db.Uuid
  submissionId      String?  @db.Uuid
  studentId         String   @db.Uuid
  alertId           String?  @db.Uuid
  courseOfferingId  String?  @db.Uuid
  diagnosis         Json
  teacherContent    Json?
  guardianContent   Json?
  teacherFeedback   Json?
  managementSummary Json?
  createdAt         DateTime @default(now())

  student  User              @relation(fields: [studentId], references: [id], onDelete: Cascade)
  alert    Alert?            @relation(fields: [alertId], references: [id])
  offering CourseOffering?   @relation(fields: [courseOfferingId], references: [id])
  practiceRecommendations StudyGeneration[]

  @@map("student_analyses")
}

model Notification {
  id        String              @id @default(uuid()) @db.Uuid
  userId    String              @db.Uuid
  type      String
  channel   NotificationChannel
  title     String
  body      String?
  readAt    DateTime?
  createdAt DateTime            @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model StudentReport {
  id                String       @id @default(uuid()) @db.Uuid
  studentId         String       @db.Uuid
  alertId           String       @db.Uuid
  parentSection     Json
  teacherSection    Json
  managementSection Json
  status            ReportStatus @default(NEW)
  createdAt         DateTime     @default(now())

  student User  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  alert   Alert @relation(fields: [alertId], references: [id], onDelete: Cascade)

  @@map("student_reports")
}

model Quiz {
  id               String     @id @default(uuid()) @db.Uuid
  title            String
  description      String?
  courseOfferingId String     @db.Uuid
  teacherId        String     @db.Uuid
  // When set, this quiz was generated for one specific student (e.g. a
  // post-meeting follow-up), and is only visible to that student.
  studentId        String?    @db.Uuid
  timeLimit        Int?
  passingScore     Int?
  status           QuizStatus @default(DRAFT)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  offering  CourseOffering @relation(fields: [courseOfferingId], references: [id], onDelete: Cascade)
  teacher   User           @relation("TeacherQuizzes", fields: [teacherId], references: [id], onDelete: Cascade)
  student   User?          @relation("StudentAssignedQuizzes", fields: [studentId], references: [id], onDelete: Cascade)
  questions QuizQuestion[]
  attempts  QuizAttempt[]

  @@index([studentId])
  @@map("quizzes")
}

model Lab {
  id               String    @id @default(uuid()) @db.Uuid
  organizationId   String    @db.Uuid
  courseOfferingId String    @db.Uuid
  createdBy        String    @db.Uuid
  topic            String
  status           LabStatus @default(GENERATING)
  generatedCode    String?   @db.Text
  reviewApproved   Boolean?
  reviewFlags      Json?
  teacherNotes     String?   @db.Text
  publishedAt      DateTime?
  createdAt        DateTime  @default(now())

  courseOffering CourseOffering @relation(fields: [courseOfferingId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([courseOfferingId])
  @@map("labs")
}

model QuizQuestion {
  id        String       @id @default(uuid()) @db.Uuid
  quizId    String       @db.Uuid
  type      QuestionType
  question  String
  options   Json?
  points    Int
  order     Int
  createdAt DateTime     @default(now())

  quiz    Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  answers QuizAnswer[]

  @@map("quiz_questions")
}

model QuizAttempt {
  id          String        @id @default(uuid()) @db.Uuid
  quizId      String        @db.Uuid
  studentId   String        @db.Uuid
  startedAt   DateTime      @default(now())
  submittedAt DateTime?
  totalScore  Int?
  status      AttemptStatus @default(IN_PROGRESS)
  violations  Json          @default("[]")

  quiz    Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  student User         @relation(fields: [studentId], references: [id], onDelete: Cascade)
  answers QuizAnswer[]

  @@unique([quizId, studentId])
  @@map("quiz_attempts")
}

model QuizAnswer {
  id            String   @id @default(uuid()) @db.Uuid
  attemptId     String   @db.Uuid
  questionId    String   @db.Uuid
  answer        String
  pointsAwarded Int?
  isConfirmed   Boolean  @default(false)
  aiFeedback    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  attempt  QuizAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([attemptId, questionId])
  @@map("quiz_answers")
}

model DeviceToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  token     String
  platform  String   @default("unknown")
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, token])
  @@map("device_tokens")
}

model HomeworkHelpInteraction {
  id               String   @id @default(uuid()) @db.Uuid
  studentId        String   @db.Uuid
  courseOfferingId String   @db.Uuid
  question         String
  answer           String
  action           String
  sources          Json     @default("[]")
  feedback         String?
  createdAt        DateTime @default(now())

  student  User           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  offering CourseOffering @relation(fields: [courseOfferingId], references: [id], onDelete: Cascade)

  @@map("homework_help_interactions")
}

model StudyGeneration {
  id                     String   @id @default(uuid()) @db.Uuid
  studentId              String   @db.Uuid
  courseOfferingId       String   @db.Uuid
  kind                   String
  materialKind           String?
  preset                 String?
  topic                  String
  status                 String   @default("PROCESSING")
  stage                  String   @default("QUEUED")
  error                  String?
  sources                Json     @default("[]")
  payload                Json?
  audioUrl               String?
  fileUrl                String?
  durationSeconds        Int?
  recommendedForAnalysisId String? @db.Uuid
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  student  User            @relation(fields: [studentId], references: [id], onDelete: Cascade)
  offering CourseOffering  @relation(fields: [courseOfferingId], references: [id], onDelete: Cascade)
  recommendedFor StudentAnalysis? @relation(fields: [recommendedForAnalysisId], references: [id], onDelete: SetNull)

  @@index([studentId, createdAt(sort: Desc)])
  @@index([recommendedForAnalysisId])
}

model ChatThread {
  id               String   @id @default(uuid()) @db.Uuid
  courseOfferingId String   @db.Uuid
  teacherId        String   @db.Uuid
  studentId        String   @db.Uuid
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  teacher  User           @relation("ThreadTeacher", fields: [teacherId], references: [id], onDelete: Cascade)
  student  User           @relation("ThreadStudent", fields: [studentId], references: [id], onDelete: Cascade)
  offering CourseOffering @relation(fields: [courseOfferingId], references: [id], onDelete: Cascade)
  messages ChatMessage[]

  @@unique([teacherId, studentId, courseOfferingId])
  @@map("chat_threads")
}

model ChatMessage {
  id        String    @id @default(uuid()) @db.Uuid
  threadId  String    @db.Uuid
  authorId  String    @db.Uuid
  text      String
  readAt    DateTime?
  createdAt DateTime  @default(now())

  thread ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  author User       @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([threadId, createdAt])
  @@map("chat_messages")
}

model StudentDocument {
  id                    String                    @id @default(uuid()) @db.Uuid
  studentId             String?                   @db.Uuid
  organizationId        String                    @db.Uuid
  category              StudentDocumentCategory   @default(OTHER)
  title                 String
  academicYear          String?
  fileName              String
  fileUrl               String
  mimeType              String?
  sizeBytes             Int?
  aiSuggestedCategory   String?
  aiSuggestedStudentId  String?                   @db.Uuid
  aiMatchConfidence     Float?
  uploadedById          String?                   @db.Uuid
  createdAt             DateTime                  @default(now())

  student             User?        @relation("StudentDocuments", fields: [studentId], references: [id], onDelete: Cascade)
  aiSuggestedStudent  User?        @relation("DocumentsAiSuggestedStudent", fields: [aiSuggestedStudentId], references: [id], onDelete: SetNull)
  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  uploadedBy          User?        @relation("DocumentsUploadedBy", fields: [uploadedById], references: [id])

  @@index([studentId])
  @@index([organizationId])
  @@map("student_documents")
}

enum StudentDocumentCategory {
  BIRTH_CERTIFICATE
  IMMUNIZATION_RECORD
  PREVIOUS_TRANSCRIPT
  PAYMENT_RECEIPT
  ID_DOCUMENT
  OTHER
}

model FeePayment {
  id           String    @id @default(uuid()) @db.Uuid
  studentId    String    @db.Uuid
  academicYear String
  feeType      FeeType   @default(TUITION)
  amount       Decimal   @db.Decimal(10, 2)
  amountPaid   Decimal?  @db.Decimal(10, 2)
  status       FeeStatus @default(UNPAID)
  body         String?
  paidAt       DateTime?
  dueDate      DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  student User @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, academicYear])
  @@map("fee_payments")
}

model ClassTeacherLog {
  id               String    @id @default(uuid()) @db.Uuid
  courseOfferingId String    @db.Uuid
  teacherId        String    @db.Uuid
  startedAt        DateTime  @default(now())
  endedAt          DateTime?
  createdAt        DateTime  @default(now())

  offering CourseOffering @relation(fields: [courseOfferingId], references: [id], onDelete: Cascade)
  teacher  User           @relation("TeacherClassLogs", fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([teacherId])
  @@index([courseOfferingId])
  @@map("class_teacher_logs")
}

model TeacherDocument {
  id           String              @id @default(uuid()) @db.Uuid
  teacherId    String              @db.Uuid
  type         TeacherDocumentType @default(OTHER)
  title        String
  fileName     String
  fileUrl      String
  mimeType     String?
  sizeBytes    Int?
  uploadedById String?             @db.Uuid
  createdAt    DateTime            @default(now())

  teacher    User  @relation("TeacherDocuments", fields: [teacherId], references: [id], onDelete: Cascade)
  uploadedBy User? @relation("TeacherDocumentsUploadedBy", fields: [uploadedById], references: [id])

  @@index([teacherId])
  @@map("teacher_documents")
}

model SalaryRecord {
  id         String       @id @default(uuid()) @db.Uuid
  teacherId  String       @db.Uuid
  period     String
  amount     Decimal      @db.Decimal(12, 2)
  amountPaid Decimal?     @db.Decimal(12, 2)
  status     SalaryStatus @default(UNPAID)
  body       String?
  paidAt     DateTime?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  teacher User @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([teacherId, period])
  @@map("salary_records")
}
