DATABASE_URL=postgresql://postgres:development_password@localhost:5433/eduai_db?schema=public
SUPABASE_URL=your-supabase-project-url
SUPABASE_SERVICE_KEY=your-supabase-service-key
SUPABASE_ANON_KEY=your-supabase-anon-key
# Supabase Storage bucket that holds uploaded material files (private bucket; created once)
SUPABASE_STORAGE_BUCKET=materials

# OAuth third-party login (Supabase-mediated; the backend only initiates and exchanges)
# Comma-separated allowlist of enabled providers (route enum: google | microsoft)
OAUTH_PROVIDERS=google,microsoft
# Backend base URL used to build the OAuth redirect URI (/auth/oauth/callback)
API_URL=http://localhost:3000
# Frontend origin; the OAuth callback redirects here with the session in the URL fragment
FRONTEND_URL=http://localhost:5173

# Custom LLM provider (ITI API gateway)
CUSTOM_PROVIDER_BASE_URL=http://localhost:8000
OPENAI_API_KEY=your-openai-key
HF_TOKEN=your-huggingface-token
HF_EMBED_MODEL=mixedbread-ai/mxbai-embed-large-v1
CUSTOM_CHAT_MODEL=openai.gpt-oss-20b-1:0
CUSTOM_PROVIDER_TIMEOUT_MS=180000

# Stripe billing (test mode keys; prices created manually in the Dashboard)
STRIPE_SECRET_KEY=your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-signing-secret
STRIPE_PRICE_BASIC=price_xxx
STRIPE_PRICE_PRO=price_xxx
STRIPE_PRICE_ENTERPRISE=price_xxx

# Trial reminder sweep (hourly) — set to 'false' to disable
TRIAL_REMINDER_ENABLED=true

# --- Study Lab: podcast TTS ---
# Priority: STUDY_AUDIO_MODEL (ITI gateway audio generation) > KOKORO_TTS_URL (self-hosted Kokoro) > none (transcript + browser speech)
# Gateway audio generation — requires the ITI 'video pricing' (audio-generation) entitlement on the key:
# STUDY_AUDIO_MODEL=openai.gpt-oss-120b-1:0
STUDY_HOST_VOICE=Matthew
STUDY_GUEST_VOICE=Joanna
# Self-hosted Kokoro TTS (one-time ~1.6 GB pull):
#   docker run -p 8880:8880 ghcr.io/remsky/kokoro-fastapi-cpu:latest
# or as a compose service: docker compose up -d kokoro
KOKORO_TTS_URL=http://localhost:8880/v1
KOKORO_HOST_VOICE=af_heart
KOKORO_GUEST_VOICE=am_michael

# LiveKit (managed cloud) — live video meetings
# Sign up at https://cloud.livekit.io -> project settings. LIVEKIT_URL is the
# public WSS endpoint (safe to expose); API_SECRET stays server-side only.
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_WEBHOOK_SECRET=your-livekit-webhook-secret
# LiveKit Cloud -> Webhooks tab: add POST https://<backend>/meetings/webhook/livekit
# with event filter "egress_*" + "participant_*" + "room_finished".

# Meeting recordings land in a dedicated Supabase Storage bucket via LiveKit
# Egress, which writes with S3-compatible credentials (Storage -> S3
# Settings -> Generate new keys). Recordings are then transcribed with
# Whisper (transformers.js + local ffmpeg).
SUPABASE_MEETINGS_BUCKET=meetings
SUPABASE_STORAGE_S3_ENDPOINT=https://<project-ref>.supabase.co/storage/v1/s3
SUPABASE_STORAGE_S3_REGION=us-east-1
SUPABASE_STORAGE_S3_ACCESS_KEY=your-s3-access-key
SUPABASE_STORAGE_S3_SECRET_KEY=your-s3-secret-key
# Whisper model for meeting transcripts (HuggingFace ONNX id). 'base' is a
# good size/accuracy balance; use 'small'/'medium' for better accuracy.
TRANSCRIPT_MODEL=Xenova/whisper-small
# Supabase Storage bucket holding meeting recordings (same bucket as materials)
SUPABASE_STORAGE_BUCKET=materials

# Tavily web search API key (https://tavily.com). Used by the homework help
# agent's search_web fallback tool. If missing, web search is skipped and the
# agent redirects to the teacher for off-material questions.
TAVILY_API_KEY=your-tavily-api-key
